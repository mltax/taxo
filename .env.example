NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# KakaoWork 알림봇 (선택 — 미설정 시 알림 기능은 조용히 비활성화됨)
# 카카오워크 관리자 콘솔에서 봇 생성 후 발급받는 App Key (서버 전용, 절대 NEXT_PUBLIC 아님)
KAKAOWORK_APP_KEY=
# 연차 승인 공지를 게시할 대화방의 conversation_id (봇이 해당 방에 참여 중이어야 함)
KAKAOWORK_LEAVE_ANNOUNCE_ID=
# 알림 메시지 내 '결재하기' 링크의 베이스 URL (미설정 시 운영 도메인 사용)
NEXT_PUBLIC_SITE_URL=
