NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# KakaoWork 알림봇 (선택 — 미설정 시 알림 기능은 조용히 비활성화됨)
# 개인 DM(결재 요청/결과)용 — 관리자 콘솔에서 봇 생성 후 발급받는 App Key (서버 전용, 절대 NEXT_PUBLIC 아님)
KAKAOWORK_APP_KEY=
# 연차 승인 공지 — Incoming Webhook URL (권장, 가장 간단: 공지방에 웹훅 추가 후 URL 등록)
KAKAOWORK_LEAVE_ANNOUNCE_WEBHOOK_URL=
# 연차 승인 공지 — (대안) 봇으로 게시할 대화방 conversation_id (봇이 그 방에 참여 중일 때)
KAKAOWORK_LEAVE_ANNOUNCE_ID=
# 알림 메시지 내 '결재하기' 링크의 베이스 URL (미설정 시 운영 도메인 사용)
NEXT_PUBLIC_SITE_URL=
